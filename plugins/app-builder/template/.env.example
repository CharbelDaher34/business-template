# Settings for this app. new-app copies this file to .env and fills it in.
# .env holds secrets: it is never committed, and only you edit it.

# The app's name, shown in the browser tab, the sidebar and the API docs.
APP_NAME="My App"

# Unique name for this app's Docker containers, volumes and network on the
# shared server. Lowercase letters, digits and dashes.
COMPOSE_PROJECT_NAME=

# The ONE port this app uses on the server (40000, 40020, 40040, ...).
# Left empty on purpose: Claude picks a free one (see the app-builder plugin's
# ports guide) and tells you. Let Charbel know which port your app uses.
APP_PORT=

# Which user the app's containers run as, so files they create in this folder
# (migrations, generated code, installed packages) belong to you.
#   Normal Docker:   your own ids, from `id -u` and `id -g`.
#   Rootless Docker: 0 and 0 (there, the container's root user *is* you).
# new-app detects this for you.
CONTAINER_UID=
CONTAINER_GID=

# Database (only reachable inside Docker, never published)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=changethis

# Secret used to sign logins. Generate one with: openssl rand -hex 32
SECRET_KEY=changethis

# First admin account, created automatically on the first start.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=changethis

# DATA_IS_REAL tells Claude whether the database holds data you care about.
#   false: test data only. When the design changes, Claude may wipe and rebuild
#          the database (always after asking you).
#   true:  real data. The database is never wiped again; changes are made with
#          careful migrations that keep every row.
# Keep it the same as "data_is_real" in .app-builder.json.
DATA_IS_REAL=false
